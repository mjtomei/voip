# Copy to .env; no credentials belong here. Compose reads this file.
VOICE_WORKSPACE=/absolute/path/to/voice-workspace
CODEX_SOCKET_DIR=/absolute/path/to/codex-home/app-server-control
VOICE_UID=1000
VOICE_GID=1000
VOIP_CONTAINER_NAME=voice-operator
# Optional compose.local.yaml settings; uncomment when using that overlay.
# HOST_CODEX_HOME=/absolute/path/to/codex-home
# VOICE_PROJECT_DIR=/absolute/path/to/external-project
