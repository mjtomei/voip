# Copy to state/twilio.env in the private workspace and chmod 600 that copy.
# Set [service].credentials_file = "state/twilio.env" in server.toml.
# Literal KEY=value only: no export, quotes, shell expansion or inline comments.
# Replace both placeholders with an authorized Twilio API key's SID and secret.
TWILIO_API_KEY_SID=REPLACE_WITH_TWILIO_API_KEY_SID
TWILIO_API_KEY_SECRET=REPLACE_WITH_TWILIO_API_KEY_SECRET
# TWILIO_SID and TWILIO_SECRET are legacy aliases; prefer the names above.
# Account credentials, SIP passwords and recipient PINs do not belong here.
